{
  "ConnectionStrings": {
    "Default": "Host=127.0.0.1;Port=5433;Database=swc;Username=swc;Password=swc"
  },
  "Jwt": {
    "Issuer": "mero-swasthya",
    "AccessAudience": "mero-swasthya-api",
    "TempAudience": "mero-swasthya-otp",
    "AccessSigningKey": "",
    "GrantSigningKey": "",
    "AccessTokenHours": 12,
    "TempTokenMinutes": 10,
    "RefreshTokenDays": 30
  },
  "Features": {
    "SmsMode": "mock",
    "AiMode": "off",
    "OtpDemo": true,
    "NidEnabled": false,
    "HmisExportEnabled": false,
    "CouncilVerifyEnabled": false
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}" } }
    ]
  },
  "AllowedHosts": "*"
}
