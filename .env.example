# Copy to .env (or set in your shell). Standard .NET form: Section__Key.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5000

ConnectionStrings__Default=Host=127.0.0.1;Port=5433;Database=swc;Username=swc;Password=swc
# Alternatively (spec form): DATABASE_URL=postgres://swc:swc@127.0.0.1:5433/swc

# Two different HS256 keys, each >= 32 bytes. Spec aliases: JWT_SECRET, GRANT_SECRET.
Jwt__AccessSigningKey=change-me-access-signing-key-at-least-32-bytes
Jwt__GrantSigningKey=change-me-grant-signing-key-at-least-32-bytes-too
Jwt__AccessTokenHours=12
Jwt__RefreshTokenDays=30

# mock = OTP responses carry demoOtp and SMS goes to /demo/sms. Spec alias: SMS_MODE.
Features__SmsMode=mock
Features__OtpDemo=true
# off = aiSummaryEnabled=false in /config. Spec alias: AI_MODE.
Features__AiMode=off
Features__NidEnabled=false
Features__HmisExportEnabled=false
Features__CouncilVerifyEnabled=false

# Background worker that sends due reminders through the SMS sender (mock outbox while SmsMode=mock).
Reminders__WorkerEnabled=true
Reminders__PollInterval=00:01:00

Database__MigrateOnStartup=true
Database__SeedOnStartup=true
Swagger__Enabled=true

# Reserved for later modules (Reminders queue, Documents storage) — same defaults as docker-compose.yml.
Redis__Connection=127.0.0.1:6379
Storage__Endpoint=http://127.0.0.1:9000
Storage__AccessKey=minio
Storage__SecretKey=minio123
Storage__Bucket=swc-documents

# Contract tests: when Docker is unavailable they use this server (a throwaway database is created and dropped).
MS_TEST_PG=Host=127.0.0.1;Port=5433;Username=swc;Password=swc;Database=postgres
